{
  "mcpServers": {
    "tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}"
    },
    "browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/owen/WorkBuddy/claude-code-browser/mcp-server/index.js"
      ],
      "env": {}
    },
    "obsidian-vault": {
      "type": "http",
      "url": "https://127.0.0.1:27124/mcp",
      "headers": {
        "Authorization": "Bearer ${OBSIDIAN_TOKEN}"
      }
    }
  }
}
